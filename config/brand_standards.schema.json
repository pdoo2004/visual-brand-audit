{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photography Standards",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rubric_id",
    "name",
    "flag_threshold",
    "brand_palette",
    "criteria",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "rubric_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "flag_threshold": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "brand_palette": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_decision",
        "interface_contract",
        "weights_status",
        "palette_status",
        "tone_status",
        "on_unavailable",
        "scoring_ready"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "source_decision": {
          "type": "string",
          "minLength": 1
        },
        "interface_contract": {
          "type": "string",
          "minLength": 1
        },
        "weights_status": {
          "type": "string",
          "minLength": 1
        },
        "palette_status": {
          "type": "string",
          "minLength": 1
        },
        "tone_status": {
          "type": "string",
          "minLength": 1
        },
        "flag_threshold_status": {
          "type": "string",
          "minLength": 1
        },
        "on_unavailable": {
          "const": "unavailable_needs_review"
        },
        "scoring_ready": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "name",
        "definition",
        "evaluation_evidence",
        "method",
        "weight",
        "params",
        "required_measurements"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_evidence": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "enum": [
            "cv",
            "vlm"
          ]
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "required_measurements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implementation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "settings": {
          "type": "object",
          "description": "Analyzer settings: CV measurement options or VLM analysis options. CV implementation-specific settings are validated through the registry.",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "cv"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "implementation_id",
              "settings"
            ]
          },
          "else": {
            "required": [
              "settings"
            ],
            "properties": {
              "implementation_id": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "vlm"
              },
              "criterion_id": {
                "const": "tone_approachability"
              }
            },
            "required": [
              "method",
              "criterion_id"
            ]
          },
          "then": {
            "properties": {
              "settings": {
                "$ref": "#/$defs/toneSettings"
              },
              "params": {
                "$ref": "#/$defs/toneParams"
              },
              "required_measurements": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "fit_score",
                    "label",
                    "evidence"
                  ]
                },
                "contains": {
                  "const": "fit_score"
                }
              }
            }
          }
        }
      ]
    },
    "toneSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_tone"
      ],
      "properties": {
        "target_tone": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Desired tone description supplied to the VLM, for example approachable, competent. The VLM client must use this setting when constructing the prompt."
        }
      }
    },
    "toneParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fit_score_min",
        "fit_score_max",
        "threshold_status"
      ],
      "properties": {
        "fit_score_min": {
          "type": "integer",
          "const": 1
        },
        "fit_score_max": {
          "type": "integer",
          "const": 5
        },
        "threshold_status": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "score_mapping": {
          "const": "linear_1_5_to_0_100",
          "description": "Required by the current scoring implementation to map fit scores to 0-100."
        }
      }
    }
  }
}
