# Copy this file to .env and fill in values before running docker compose.

# ── Model server ─────────────────────────────────────────────────────────────

# Without the gpu profile: Ollama runs on the host.
# On Docker Desktop the host is reachable via host.docker.internal.
BRANDLENS_MODEL_BASE_URL=http://host.docker.internal:11434/v1
BRANDLENS_MODEL_NAME=gemma4:e4b

# With the gpu profile: vLLM runs as the vlm container.
# Uncomment these two lines and run:
#   docker compose --profile gpu up
#BRANDLENS_MODEL_BASE_URL=http://vlm:8000/v1
#BRANDLENS_MODEL_NAME=google/gemma-4-E4B-it

# ── vLLM (gpu profile only) ───────────────────────────────────────────────────

# Hugging Face token for downloading gated Gemma 4 weights.
HF_TOKEN=

# Model variant served by vLLM. E4B needs ~24 GB VRAM.
VLM_MODEL=google/gemma-4-E4B-it
VLM_MAX_MODEL_LEN=4096
